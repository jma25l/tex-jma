}

% MACRO SECCIONS DEMOSTRACIO
\newcommand\sepDemo[1]{
	\par \begin{tabular}{r|}
		#1\\ \hline
	\end{tabular}\\[0.2cm]
}

\newcommand{\directa}{\sepDemo{$\implies$}}
\newcommand{\reciproc}{\sepDemo{$\impliedby$}}

\newcommand{\qed}{\begin{flushright}\textit{qed}\end{flushright}}


% MACRO SEPARADOR TRIF
\newcommand\sepTri[2]{
	\vspace*{0.1cm}
	{\color{#2}
	\hrule
	\begin{center}
		#1
	\end{center}
	\hrule
	}\vspace*{0.4cm}
}


